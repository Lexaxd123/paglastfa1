#--------------------------------------------------------------------
# Morris POS - Environment template
# Copy this file to ".env" and fill in your own values.
# NEVER commit the real .env (it is already listed in .gitignore).
#--------------------------------------------------------------------

# Use "development" locally, "production" on the hosted site
# (production hides stack traces and the debug toolbar).
CI_ENVIRONMENT = development

# Change this to your hosted URL when deploying, e.g.
# app.baseURL = 'https://morris-pos.example.com/'
app.baseURL = 'http://localhost:8080/'

#--------------------------------------------------------------------
# DATABASE
#--------------------------------------------------------------------
database.default.hostname = localhost
database.default.database = pos_db
database.default.username = root
database.default.password =
database.default.DBDriver = MySQLi
database.default.DBPrefix =
database.default.port = 3306
